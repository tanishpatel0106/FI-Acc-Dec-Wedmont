# --- WRDS (Columbia subscription). Duo push is triggered on first connection. ---
WRDS_USERNAME=
WRDS_PASSWORD=

# --- Optional public API keys (fredgraph CSV endpoint works without a key) ---
FRED_API_KEY=

# --- Backend ---
LIFECYCLE_DATA_DIR=./data
# set to use arq workers on Redis instead of the in-process executor
REDIS_URL=
API_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
